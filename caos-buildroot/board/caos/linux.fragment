# CAOS Linux kernel policy
#
# The appliance is deliberately network-free.  These assignments are applied
# on top of the upstream x86_64 defconfig by Buildroot's Kconfig merge.
# Do not re-enable networking to make a package build: remove that package.

# CONFIG_NET is not set
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_PACKET is not set
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
# CONFIG_MODULES is not set

# --- Boot, console and userspace ABI ---------------------------------------
# Boot is pure x86_64 UEFI through GRUB's EFI application.  The disk is GPT
# only, so the legacy DOS/MBR partition parser is intentionally not built.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Enabling PARTITION_ADVANCED is what makes the otherwise forced-on DOS/MBR
# parser selectable.  Only the GPT parser is enabled below.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
# CONFIG_MSDOS_PARTITION is not set
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
# UEFI systems expose a GOP framebuffer, not VGA text mode.  Provide a DRM
# fbdev console so kernel messages and tty1 are visible on real hardware.
# simpledrm handles firmware framebuffers when no dedicated GPU driver binds;
# DRM_FBDEV_EMULATION keeps the console when i915 (or another DRM driver) takes
# over.  fbcon is what actually renders tty0/tty1.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# The appliance has no audio, Intel ME or GPU compute workload.  On some ASUS
# firmware the HDA/MEI probes stall for many seconds and the i915 probe can
# hang before fbcon appears.  Keep only simpledrm/fbcon for the local display.
# CONFIG_SOUND is not set
# CONFIG_INTEL_MEI is not set
# CONFIG_DRM_I915 is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# --- Storage needed to boot, mount CAOSROOT and manage CAOSDATA -----------
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_PCI=y
CONFIG_EXT4_FS=y
CONFIG_JBD2=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_XZ_DEC=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y

# --- Kernel self-protection ------------------------------------------------
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_DEVKMEM is not set
