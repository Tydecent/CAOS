# /etc/inittab for the CAOS appliance.
#
# BusyBox init is used.  The root filesystem is a read-only squashfs and is
# never remounted read-write.

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys /run/caos-ca
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Serial console (115200 8N1) and local VGA console.
ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100
tty1::respawn:/sbin/getty -L tty1 115200 vt100

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
