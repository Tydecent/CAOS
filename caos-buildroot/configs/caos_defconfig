# CAOS air-gapped certificate authority - Buildroot defconfig
#
# Build with:
#   make O=../output BR2_EXTERNAL=../caos-buildroot caos_defconfig
# or simply use ../build.sh.

# --- Architecture and toolchain -------------------------------------------
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# --- Download policy -------------------------------------------------------
# Prefer the official Buildroot source mirror, then fall back to upstream.
BR2_PRIMARY_SITE="https://sources.buildroot.net"

# --- Generic system settings ----------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="caos"
BR2_TARGET_GENERIC_ISSUE="CAOS - Air-Gapped Certificate Authority"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_GETTY_TERM="vt100"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_INIT_BUSYBOX=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# --- Root filesystem -------------------------------------------------------
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/rootfs-overlay"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/post-image.sh"

BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

# --- Linux kernel ----------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.55"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- UEFI boot loader ------------------------------------------------------
# Build only the x86_64 EFI GRUB application.  No i386-pc/BIOS GRUB target is
# selected.  The embedded script locates the FAT ESP by its volume label and
# loads /EFI/BOOT/grub.cfg from it, so the kernel and its command line can be
# maintained as an ordinary file on the ESP.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fat part_gpt search search_label configfile normal efi_gop"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/grub-builtin.cfg"

# --- Target userspace ------------------------------------------------------
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CAOS_PATH)/board/caos/busybox.fragment"
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y

# Explicitly keep these out of the image.
# BR2_PACKAGE_OPENSSH is not set
# BR2_PACKAGE_CURL is not set
# BR2_PACKAGE_WGET is not set
# BR2_PACKAGE_IPROUTE2 is not set
# BR2_PACKAGE_NET_TOOLS is not set
# BR2_PACKAGE_WPA_SUPPLICANT is not set
# BR2_PACKAGE_DHCP is not set

# --- Host tools used to assemble the GPT/ESP SD-card image -----------------
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
